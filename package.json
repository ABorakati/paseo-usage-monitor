{
  "name": "paseo-usage-monitor",
  "version": "0.2.0",
  "description": "Paseo plugin for model token usage limits, balances, and history tracking",
  "keywords": [
    "ai-tokens",
    "limits",
    "llm",
    "paseo",
    "paseo-plugin",
    "usage"
  ],
  "homepage": "https://github.com/ABorakati/paseo-usage-monitor#readme",
  "bugs": {
    "url": "https://github.com/ABorakati/paseo-usage-monitor/issues"
  },
  "license": "MIT",
  "author": "Aditya Borakati",
  "repository": {
    "type": "git",
    "url": "https://github.com/ABorakati/paseo-usage-monitor.git"
  },
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "server/",
    "client/",
    "shared/",
    "icons/",
    "!**/*.test.ts",
    "statusline-hook.mjs",
    "usage-limits.example.json",
    "tsconfig.json",
    "docs/*.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.0-beta.3",
    "@getpaseo/plugin": "0.11.0-beta.3",
    "@getpaseo/protocol": "0.11.0-beta.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.15.3",
    "@types/react": "~19.2.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
